{
  "name": "hackyay-ai-tutor",
  "displayName": "ai-tutor",
  "description": "An IDE plugin that intercepts runtime errors and opens an AI Tutor view inside VS Code.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./apps/extension/dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-tutor",
          "title": "AI Tutor",
          "icon": "apps/extension/resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-tutor": [
        {
          "id": "aiTutorView",
          "name": "AI Tutor",
          "type": "webview",
          "icon": "apps/extension/resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "hackyay-ai-tutor.runCurrentPythonFile",
        "title": "AI Tutor: Run Current Java File"
      },
      {
        "command": "hackyay-ai-tutor.openTutorPanel",
        "title": "AI Tutor: Show AI Tutor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hackyay-ai-tutor.runCurrentPythonFile",
          "when": "resourceExtname == .java",
          "group": "navigation"
        },
        {
          "command": "hackyay-ai-tutor.openTutorPanel",
          "when": "resourceExtname == .java",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "AI Tutor",
      "properties": {
        "hackyayAiTutor.javaPath": {
          "type": "string",
          "default": "java",
		  "description": "Java executable used to run the current Java file. Java 11 or later is required for source-file mode."
        },
        "hackyayAiTutor.runtimeTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Maximum time allowed for running the current Python file in milliseconds."
        }
      }
    }
  },
  "workspaces": [
    "apps/extension",
    "apps/backend"
  ],
  "scripts": {
    "compile": "npm run extension:compile",
    "watch": "npm run extension:watch",
    "extension:compile": "npm --workspace apps/extension run compile",
    "extension:watch": "npm --workspace apps/extension run watch",
    "backend:check-types": "npm --workspace apps/backend run check-types"
  }
}
