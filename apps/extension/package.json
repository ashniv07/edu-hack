{
  "name": "hackyay-ai-tutor",
  "displayName": "ai-tutor",
  "description": "A VS Code extension that runs Python/Java files, captures runtime errors, and opens an AI Tutor view inside the editor.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-tutor",
          "title": "AI Tutor",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-tutor": [
        {
          "id": "aiTutorView",
          "name": "AI Tutor",
          "type": "webview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "hackyay-ai-tutor.runCurrentPythonFile",
        "title": "AI Tutor: Run Current File"
      },
      {
        "command": "hackyay-ai-tutor.openTutorPanel",
        "title": "AI Tutor: Show AI Tutor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hackyay-ai-tutor.runCurrentPythonFile",
          "when": "resourceExtname == .py || resourceExtname == .java",
          "group": "navigation"
        },
        {
          "command": "hackyay-ai-tutor.openTutorPanel",
          "when": "resourceExtname == .py || resourceExtname == .java",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "AI Tutor",
      "properties": {
        "hackyayAiTutor.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to run Python files. Python 3.8 or later is recommended."
        },
        "hackyayAiTutor.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to run Java files. Java 11 or later is required for source-file mode."
        },
        "hackyayAiTutor.runtimeTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Maximum time allowed for running the current file in milliseconds."
        },
        "hackyayAiTutor.backendUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Backend URL used by AI Tutor to analyze runtime failures."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.11.2",
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
