{
  "name": "@hackyay-ai-tutor/backend",
  "version": "0.0.1",
  "private": true,
  "description": "LangGraph-ready backend scaffold for AI Tutor.",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "demo:agents": "npm run build && node dist/demoAgentRun.js",
		"test": "vitest run src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "web-tree-sitter": "^0.26.11"
  }
}
